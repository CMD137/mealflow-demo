# MealFlow local environment template. Copy to .env and fill real values locally.
# Do not commit .env or real cloud credentials.

# local | aliyun-oss
MEALFLOW_STORAGE_PROVIDER=local
MEALFLOW_STORAGE_PUBLIC_BASE_URL=

# Required only when MEALFLOW_STORAGE_PROVIDER=aliyun-oss.
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_OBJECT_PREFIX=catalog

# Authentication. Generate long random values locally; never commit .env.
AUTH_OTP_PEPPER=
AUTH_SESSION_PEPPER=
AUTH_OTP_LOG_CODE=true

# Production Compose secrets. Do not use these development-friendly defaults in production.
MYSQL_ROOT_PASSWORD=
NACOS_AUTH_TOKEN=

# Alipay sandbox. Keep all key material only in .env.
ALIPAY_APP_ID=9021000166674569
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
PAYMENT_PROVIDER=alipay-sandbox
NGROK_AUTHTOKEN=
NGROK_URL=
