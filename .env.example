# MealFlow local environment template. Copy to .env and fill real values locally.
# Do not commit .env or real cloud credentials.

# local | aliyun-oss
MEALFLOW_STORAGE_PROVIDER=local
MEALFLOW_STORAGE_PUBLIC_BASE_URL=

# Required only when MEALFLOW_STORAGE_PROVIDER=aliyun-oss.
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_OBJECT_PREFIX=catalog

# Authentication. Generate long random values locally; never commit .env.
AUTH_OTP_PEPPER=
AUTH_SESSION_PEPPER=
AUTH_OTP_LOG_CODE=true

# Production Compose secrets. Do not use these development-friendly defaults in production.
MYSQL_ROOT_PASSWORD=
NACOS_AUTH_TOKEN=

# Support bridge bidirectional authentication. Use two different random values in production.
SUPPORT_INTERNAL_TOOL_TOKEN=
AGENT_INTERNAL_TOKEN=

# Smart customer-service Agent (OpenAI-compatible DashScope endpoint).
# Keep the API key only in the local .env file.
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.8-flash

# Alipay sandbox. Keep all key material only in .env. Start ngrok with:
# docker compose --profile alipay-sandbox up -d meal-payment alipay-ngrok
ALIPAY_APP_ID=9021000166674569
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
PAYMENT_PROVIDER=alipay-sandbox
# Browser redirect after Alipay finishes. Set this to the public user-web HTTPS URL in production.
ALIPAY_RETURN_URL=http://localhost:5174/order-result?source=alipay
NGROK_AUTHTOKEN=
# Bare reserved domain, for example: example.ngrok-free.dev
NGROK_URL=
