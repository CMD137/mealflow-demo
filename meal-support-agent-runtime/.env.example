# ---- LLM (OpenAI compatible) ----
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---- Embeddings (OpenAI compatible) ----
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ---- Redis multi-turn memory ----
REDIS_URL=redis://localhost:6379/0
HISTORY_MAX_TURNS=10
MEMORY_TTL_SECONDS=3600

# ---- Agent loop ----
AGENT_MAX_STEPS=4

# ---- RAG ----
KNOWLEDGE_DIR=knowledge
CHROMA_DIR=knowledge/chroma
CHROMA_COLLECTION=mealflow_faq
RAG_TOP_K=3

# ---- Java bridge (the only outbound exit) ----
SUPPORT_BRIDGE_URL=http://localhost:8111

# ---- A4 bidirectional internal tokens (set the same values on both sides) ----
# Java bridge -> Python (/agent/* inbound validation)
AGENT_INTERNAL_TOKEN=
# Python -> Java (/internal/support/tools/invoke)
SUPPORT_INTERNAL_TOOL_TOKEN=change-me

# ---- SSE ----
SSE_PING_SECONDS=15
